	/// Executive headline: Stockout Risk Rate. References the Supply Chain measure.
	measure 'EXEC — Stockout Risk Rate %' =
			// [EXEC] Stockout Risk Rate %
			// Executive summary page headline KPI — Supply Chain pillar.
			// References [Stockout Risk Encounter Rate %] from the Supply Chain folder.
			// Dashboard target: 0 stockout events. Current benchmark: 4.2 events/month (Off Target).
			[Stockout Risk Encounter Rate %]
		formatString: 0.0%
		displayFolder: 00 Executive Overview
		lineageTag: ba365184-4a1c-4785-95ff-9db451d6a6d2

	/// RAG status for 30-Day Readmission Rate. Returns Green / Amber / Red for conditional formatting. Thresholds: Green <12%, Amber 12–15%, Red >15%.
	measure 'RAG — Readmission Rate' =
			// RAG Status — 30-Day Readmission Rate
			// Returns a colour category string for conditional formatting in Power BI.
			// Used with 'Field Value' conditional formatting on KPI cards and tables.
			// Thresholds (CMS HRRP aligned): Green < 12% | Amber 12–15% | Red > 15%.
			// Map to hex colours in PBI conditional formatting: Green = #2E7D32, Amber = #ED6C02, Red = #C62828.
			VAR Rate = [30-Day Readmission Rate %]
			RETURN
			    SWITCH(
			        TRUE(),
			        ISBLANK(Rate),   BLANK(),
			        Rate < 0.12,     "Green",
			        Rate <= 0.15,    "Amber",
			        "Red"
			    )
		displayFolder: 00 Executive Overview_RAG Status
		lineageTag: 8217513d-e7cf-4ba7-aebe-6ade8a6b0935

	/// RAG status for Burnout Prevalence. Returns Green / Amber / Red for conditional formatting. Thresholds: Green <20%, Amber 20–25%, Red >25%.
	measure 'RAG — Burnout Prevalence' =
			// RAG Status — Burnout Prevalence
			// Returns a colour category string for conditional formatting in Power BI.
			// Thresholds (MBI clinical guidance): Green < 20% | Amber 20–25% | Red > 25%.
			// > 25% prevalence triggers executive review (dashboard alert threshold).
			VAR Rate = [Burnout Prevalence % (Nurse-Level)]
			RETURN
			    SWITCH(
			        TRUE(),
			        ISBLANK(Rate),   BLANK(),
			        Rate < 0.20,     "Green",
			        Rate <= 0.25,    "Amber",
			        "Red"
			    )
		displayFolder: 00 Executive Overview_RAG Status
		lineageTag: 430ca681-7ff5-46fb-98b4-f68ec9bd1551

	/// RAG status for Bed Occupancy Rate. Returns Green / Amber / Red. Target zone: 75–85%.
	measure 'RAG — Bed Occupancy' =
			// RAG Status — Bed Occupancy Rate
			// Returns a colour category string for conditional formatting.
			// Optimal zone: 75–85%. Below = under-utilised; above = overcrowding risk.
			// Thresholds: Green 75–85% | Amber 85–92% or <70% | Red >92% or <65%.
			VAR Rate = [Bed Occupancy Rate %]
			RETURN
			    SWITCH(
			        TRUE(),
			        ISBLANK(Rate),               BLANK(),
			        Rate >= 0.75 && Rate <= 0.85, "Green",
			        Rate > 0.85 && Rate <= 0.92,  "Amber",
			        Rate >= 0.65 && Rate < 0.75,  "Amber",
			        "Red"
			    )
		displayFolder: 00 Executive Overview_RAG Status
		lineageTag: cb04c2d9-9584-4a7e-b3fa-8b5096c51784

	/// RAG status for FWA Detection Rate. Returns Green / Amber / Red. Thresholds: Green <2%, Amber 2–5%, Red >5%.
	measure 'RAG — FWA Detection Rate' =
			// RAG Status — FWA Detection Rate
			// Returns a colour category string for conditional formatting.
			// Thresholds: Green < 2% | Amber 2–5% | Red > 5%.
			// > 5% FWA rate triggers mandatory compliance department escalation.
			VAR Rate = [FWA Detection Rate %]
			RETURN
			    SWITCH(
			        TRUE(),
			        ISBLANK(Rate),   BLANK(),
			        Rate < 0.02,     "Green",
			        Rate <= 0.05,    "Amber",
			        "Red"
			    )
		displayFolder: 00 Executive Overview_RAG Status
		lineageTag: cb66d351-6a89-4c16-915e-500c58fd2d8d

	/// RAG status for Stockout Risk Rate. Returns Green / Amber / Red. Any non-zero rate = Amber or Red.
	measure 'RAG — Stockout Risk' =
			// RAG Status — Stockout Risk Rate
			// Returns a colour category string for conditional formatting.
			// Target: 0 stockout events in any period.
			// Thresholds: Green = 0% | Amber 0–2% | Red > 2%.
			// Even a single stockout event should be surfaced in reports as it risks surgical case cancellation.
			VAR Rate = [Stockout Risk Encounter Rate %]
			RETURN
			    SWITCH(
			        TRUE(),
			        ISBLANK(Rate),   BLANK(),
			        Rate = 0,        "Green",
			        Rate <= 0.02,    "Amber",
			        "Red"
			    )
		displayFolder: 00 Executive Overview_RAG Status
		lineageTag: d43360cb-4b60-4d30-9244-8fd3e1182133

	/// Executive headline: 30-Day Readmission Rate %. Target < 15% (CMS HRRP).
	measure '[EXEC] 30-Day Readmission Rate %' =
