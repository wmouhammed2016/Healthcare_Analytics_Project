	/// Executive headline: Nurse-Level Burnout Prevalence. References the HR measure.
	measure 'EXEC — Burnout Prevalence %' =
			// [EXEC] Burnout Prevalence %
			// Executive summary page headline KPI — HR pillar.
			// References [Burnout Prevalence % (Nurse-Level)] from the HR folder.
			// Dashboard alert threshold: > 25% (current benchmark: 31% — Off Target).
			// ICU and ED units are driving the spike per dashboard insight layer.
			[Burnout Prevalence % (Nurse-Level)]
