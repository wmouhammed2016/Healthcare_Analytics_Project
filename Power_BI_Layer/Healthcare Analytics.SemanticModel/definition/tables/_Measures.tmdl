	/// RAG status for 30-Day Readmission Rate. Green < 12%, Amber 12-15%, Red > 15%. For conditional formatting use.
	measure '[RAG] Readmission Status' =
			// [RAG] 30-Day Readmission Status
			// Returns a text RAG status for use in conditional formatting rules and status indicator visuals.
			// Green: rate < 12% (outperforming target)
			// Amber: 12% ≤ rate ≤ 15% (within target range but approaching threshold)
			// Red: rate > 15% (CMS HRRP penalty risk)
			// Usage: apply this measure as the conditional formatting field on a KPI card or table.
			VAR Rate = [30-Day Readmission Rate %]
			RETURN
			    SWITCH(
			        TRUE(),
			        ISBLANK(Rate), BLANK(),
			        Rate < 0.12, "Green",
			        Rate <= 0.15, "Amber",
			        "Red"
			    )
		displayFolder: 00 Executive Overview\RAG Status
		lineageTag: ba0739f9-a58e-48e9-bced-a4cf80f087c6

	/// RAG status for Burnout Prevalence. Green < 20%, Amber 20-25%, Red > 25%.
	measure '[RAG] Burnout Prevalence Status' =
			// [RAG] Burnout Prevalence Status
			// Returns RAG text for nurse-level burnout prevalence rate.
			// Green: < 20% (well-managed)
			// Amber: 20–25% (watch — approaching executive alert threshold)
			// Red: > 25% (executive escalation required per HR policy)
			VAR Rate = [Burnout Prevalence % (Nurse-Level)]
			RETURN
			    SWITCH(
			        TRUE(),
			        ISBLANK(Rate), BLANK(),
			        Rate < 0.20, "Green",
			        Rate <= 0.25, "Amber",
			        "Red"
			    )
		displayFolder: 00 Executive Overview\RAG Status
		lineageTag: 1940acd5-90ed-46a2-a2a5-efd6c209bf08

	/// RAG status for OR Utilisation Rate. Green 70-85%, Amber 85-90%, Red > 90% or < 65%.
	measure '[RAG] OR Utilisation Status' =
			// [RAG] OR Utilisation Status
			// Returns RAG text for OR utilisation rate.
			// Green: 70–85% (optimal AORN throughput range)
			// Amber: 85–90% or 65–70% (outside optimal but manageable)
			// Red: > 90% (scheduling pressure / burnout risk) or < 65% (severe underutilisation)
			VAR Rate = [OR Utilisation Rate %]
			RETURN
			    SWITCH(
			        TRUE(),
			        ISBLANK(Rate), BLANK(),
			        Rate >= 0.70 && Rate <= 0.85, "Green",
			        Rate > 0.85 && Rate <= 0.90, "Amber",
			        Rate >= 0.65 && Rate < 0.70, "Amber",
			        "Red"
			    )
		displayFolder: 00 Executive Overview\RAG Status
		lineageTag: d8f16d19-7cb8-46f4-9210-3411eb6bd330

	/// RAG status for FWA Detection Rate. Green < 2%, Amber 2-5%, Red > 5%.
	measure '[RAG] FWA Status' =
			// [RAG] FWA Detection Status
			// Returns RAG text for the FWA Detection Rate.
			// Green: < 2% (within normal audit variance)
			// Amber: 2–5% (elevated — targeted coder review recommended)
			// Red: > 5% (exceeds CMS audit threshold; compliance programme escalation required)
			VAR Rate = [FWA Detection Rate %]
			RETURN
			    SWITCH(
			        TRUE(),
			        ISBLANK(Rate), BLANK(),
			        Rate < 0.02, "Green",
			        Rate <= 0.05, "Amber",
			        "Red"
			    )
		displayFolder: 00 Executive Overview\RAG Status
		lineageTag: de2b3a66-4fd7-4ebf-9b32-41f98afe9d92

	/// RAG status for Stockout Risk Rate. Green = 0%, Amber > 0% to 2%, Red > 2%.
	measure '[RAG] Stockout Status' =
			// [RAG] Stockout Risk Status
			// Returns RAG text for the supply chain stockout risk encounter rate.
			// Green: 0% (zero stockout risk — the only acceptable steady-state)
			// Amber: > 0% to 2% (isolated events — investigation required)
			// Red: > 2% (systemic supply chain failure — executive escalation)
			VAR Rate = [Stockout Risk Encounter Rate %]
			RETURN
			    SWITCH(
			        TRUE(),
			        ISBLANK(Rate), BLANK(),
			        Rate = 0, "Green",
			        Rate <= 0.02, "Amber",
			        "Red"
			    )
		displayFolder: 00 Executive Overview\RAG Status
		lineageTag: 3ee7657c-fe78-4bdf-b06f-9ab0b08bf863

	/// YTD 30-Day Readmission Rate using triage date. Requires dimDate to be marked as Date Table (completed in this build).
	measure '30-Day Readmission Rate % YTD' =
			// [TI] 30-Day Readmission Rate % YTD
			// Year-to-date readmission rate calculated using the active triage_date_sk relationship.
			// DATESYTD uses the date_key column of the now-marked Date Table (dimDate).
			// Prerequisite: dimDate (gold vw_dim_encounter_date) must be marked as Date Table.
			// This was completed as part of the same build that created this measure.
			// Use this measure in trend line charts to show cumulative YTD performance vs. prior year YTD.
			CALCULATE(
			    [30-Day Readmission Rate %],
			    DATESYTD('gold vw_dim_encounter_date'[date_key])
			)
		formatString: 0.0%
		displayFolder: 01 Clinical\Time Intelligence
		lineageTag: 6de94568-c757-4372-b287-93feba7ce036

	/// YTD Average LOS using triage date. Requires dimDate marked as Date Table.
	measure 'Avg LOS YTD' =
			// [TI] Avg LOS YTD
			// Year-to-date average length of stay using the active triage_date_sk relationship.
			// Accumulates from January 1 of the current year through the selected date period.
			// Useful for monitoring LOS trend within the year vs. prior year YTD comparison.
			CALCULATE(
			    [Avg Length of Stay (Days)],
			    DATESYTD('gold vw_dim_encounter_date'[date_key])
			)
		formatString: 0.0
		displayFolder: 01 Clinical\Time Intelligence
		lineageTag: 4fc44091-116f-4b56-9e3f-a92e91ba3b84

	/// YTD FWA Detection Rate using triage date. Tracks cumulative billing integrity across the year.
	measure 'FWA Detection Rate % YTD' =
			// [TI] FWA Detection Rate % YTD
			// Year-to-date FWA detection rate using the active triage_date_sk relationship.
			// Monitors cumulative billing integrity performance from year start to selected period.
			// Rising YTD rate signals systemic billing issues rather than isolated incidents.
			CALCULATE(
			    [FWA Detection Rate %],
			    DATESYTD('gold vw_dim_encounter_date'[date_key])
			)
		formatString: 0.0%
		displayFolder: 03 Financial & Revenue Cycle\Time Intelligence
		lineageTag: d950a778-a34d-4995-9e3e-08f6dc15ea6d

	/// Avg LOS analysed by discharge date using USERELATIONSHIP on the inactive relationship. Enables discharge-cohort analysis.
	measure 'Avg LOS by Discharge Date' =
			// [TI] Avg LOS by Discharge Date
			// Average Length of Stay filtered using the INACTIVE discharge_date_sk → date_sk relationship.
			// USERELATIONSHIP activates this relationship for this measure only, without affecting others.
			// Use this measure when the business question is:
			//   'For patients DISCHARGED in period X, what was their average LOS?'
			// Contrast with [Avg Length of Stay (Days)] which filters on triage/admission date.
			// Essential for discharge cohort analysis, readmission follow-up tracking, and DRG billing reconciliation.
			CALCULATE(
			    [Avg Length of Stay (Days)],
			    USERELATIONSHIP(
			        'gold vw_fact_encounter'[discharge_date_sk],
			        'gold vw_dim_encounter_date'[date_sk]
			    )
			)
		formatString: 0.0
		displayFolder: 01 Clinical\Time Intelligence
		lineageTag: 69a9f128-aa23-4a03-9613-79b69d2d908d

	partition _Measures = m
		mode: import
		source =
				let
				    Source = Table.FromRows(Json.Document(Binary.Decompress(Binary.FromText("i44FAA==", BinaryEncoding.Base64), Compression.Deflate)), let _t = ((type nullable text) meta [Serialized.Text = true]) in type table [Column1 = _t]),
				    #"Changed Type" = Table.TransformColumnTypes(Source,{{"Column1", type text}}),
				    #"Removed Columns" = Table.RemoveColumns(#"Changed Type",{"Column1"})
				in
				    #"Removed Columns"

	annotation PBI_ResultType = Table

