	/// Executive headline: Nurse-level burnout prevalence %. Target: < 25% (executive alert threshold).
	measure '[EXEC] Burnout Prevalence %' =
			// [EXEC] Burnout Prevalence % (HR Pillar)
			// Executive headline KPI for the HR & Workforce pillar.
			// Nurse-level prevalence rate: proportion of distinct nurses with high MBI burnout.
			// Executive alert fires when this rate exceeds 25%.
			// References the HR domain measure directly.
			[Burnout Prevalence % (Nurse-Level)]
		formatString: 0.0%
		displayFolder: 00 Executive Overview
		lineageTag: 301aab7f-19ea-4574-ab30-be8842fff724

	/// Executive headline: % of encounters with a stockout risk flag. Target: 0.
	measure '[EXEC] Stockout Risk Rate %' =
			// [EXEC] Stockout Risk Rate %
			// Executive headline KPI for the Supply Chain pillar.
			// Proportion of encounters where a surgical kit stockout risk was active.
			// Any non-zero rate in an executive period review is an escalation signal.
			// References the Supply Chain domain measure directly.
			[Stockout Risk Encounter Rate %]
		formatString: 0.0%
